# SkyOps Frontend Environment Configuration
# Copy this file to .env.local for local overrides (never commit .env or .env.local)

# FastAPI Backend Base URL (conforms to docs/api.md)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Real-Time Operational WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/live-ops

# Default Hub Airport Code (e.g. DEL, BOM, BLR)
NEXT_PUBLIC_DEFAULT_AIRPORT=DEL

# Data Source Mode: 'auto' (attempts live API, falls back gracefully to contract fixtures), 'mock_only', or 'live_only'
NEXT_PUBLIC_DATA_SOURCE_MODE=auto
